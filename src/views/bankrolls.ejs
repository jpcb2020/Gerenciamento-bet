<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gerenciar Bankrolls - BetManager</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/bankrolls.css">
</head>
<body>
    <div class="container">
        <!-- Sideebar -->
        <aside class="sidebar">
            <div class="sidebar-header">
                <h1>BetManager</h1>
                <button id="menu-toggle" class="mobile-menu-btn">
                    <i class="fas fa-bars"></i>
                </button>
            </div>
            <nav class="sidebar-nav">
                <ul>
                    <li>
                        <a href="/dashboard"><i class="fas fa-tachometer-alt"></i> Dashboard</a>
                    </li>
                    <li>
                        <a href="/casas-de-apostas"><i class="fas fa-home"></i> Casas de Apostas</a>
                    </li>
                    <li>
                        <a href="/casas-regulamentadas"><i class="fas fa-check-circle"></i> Casas Regulamentadas</a>
                    </li>
                    <li>
                        <a href="/transacoes"><i class="fas fa-exchange-alt"></i> Transações</a>
                    </li>
                    <li class="active"> <!-- Marcar como ativo -->
                        <a href="/bankrolls"><i class="fas fa-wallet"></i> Bankrolls</a>
                    </li>
                    <li>
                        <a href="#relatorios"><i class="fas fa-chart-bar"></i> Relatórios</a>
                    </li>
                    <li>
                        <a href="#configuracoes"><i class="fas fa-cog"></i> Configurações</a>
                    </li>
                    <li class="logout-item">
                        <a href="#" id="logout-btn"><i class="fas fa-sign-out-alt"></i> Logout</a>
                    </li>
                </ul>
            </nav>
            <div class="sidebar-footer">
                <p>© 2025 BetManager</p>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="main-content">
            <header class="main-header">
                <div class="header-search">
                    <input type="text" placeholder="Pesquisar...">
                    <i class="fas fa-search"></i>
                </div>
                <div class="header-user">
                    <div class="notifications">
                        <i class="fas fa-bell"></i>
                        <span class="badge">3</span>
                    </div>
                    <div class="user-profile" id="userProfile">
                        <div class="user-avatar-placeholder">
                            <i class="fas fa-user"></i>
                        </div>
                        <span><%= user.nome || 'Usuário' %></span>
                        <i class="fas fa-chevron-down" style="margin-left: 8px; font-size: 0.8rem; color: var(--text-light);"></i>
                        
                        <!-- Dropdown Menu -->
                        <div class="user-dropdown" id="userDropdown">
                            <div class="dropdown-header">
                                <div class="user-avatar-placeholder" style="margin: 0 auto 10px; width: 50px; height: 50px;">
                                    <i class="fas fa-user" style="font-size: 22px;"></i>
                                </div>
                                <div class="dropdown-user-info">
                                    <h4><%= user.nome %> <%= user.sobrenome || '' %></h4>
                                    <p><%= user.email %></p>
                                </div>
                            </div>
                            <div class="dropdown-menu">
                                <a href="/profile" class="dropdown-item">
                                    <i class="fas fa-user-cog"></i>
                                    Meu Perfil
                                </a>
                                <a href="#" class="dropdown-item">
                                    <i class="fas fa-cog"></i>
                                    Configurações
                                </a>
                                <a href="#" class="dropdown-item">
                                    <i class="fas fa-chart-bar"></i>
                                    Relatórios
                                </a>
                                <div class="dropdown-divider"></div>
                                <a href="#" class="dropdown-item">
                                    <i class="fas fa-question-circle"></i>
                                    Ajuda
                                </a>
                                <div class="dropdown-divider"></div>
                                <button class="dropdown-item logout" id="logoutBtn">
                                    <i class="fas fa-sign-out-alt"></i>
                                    Logout
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </header>

            <div class="content-wrapper">
                <div class="page-title">
                    <h2>Gerenciar Bankrolls</h2>
                    <button id="addBankrollBtn" class="btn-primary">Adicionar Novo Bankroll</button>
                </div>

                <!-- Formulário Modal para Adicionar/Editar Bankroll -->
                <div id="bankrollModal" class="modal">
                    <div class="modal-content">
                        <span class="close-modal">&times;</span>
                        <h3 id="modalTitle">Adicionar Bankroll</h3>
                        <form id="bankrollForm">
                            <input type="hidden" id="bankrollId" name="bankrollId">
                            <div class="form-group">
                                <label for="nome">Nome do Bankroll:</label>
                                <input type="text" id="nome" name="nome" required>
                            </div>
                            <div class="form-group">
                                <label for="saldo_inicial">Saldo Inicial (R$):</label>
                                <input type="number" id="saldo_inicial" name="saldo_inicial" step="0.01" required>
                            </div>
                            <div class="form-group">
                                <label for="categoria">Categoria:</label>
                                <select id="categoria" name="categoria" required>
                                    <option value="">Selecione uma categoria</option>
                                    <option value="Surebet">Surebet</option>
                                    <option value="Apostas esportivas">Apostas esportivas</option>
                                    <option value="Geral">Geral</option>
                                </select>
                            </div>
                            <div class="form-actions">
                                <button type="submit" class="btn-primary">Salvar Bankroll</button>
                                <button type="button" id="cancelBtn" class="btn-secondary">Cancelar</button>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Tabela de Bankrolls ANTERIORMENTE -->
                <!-- <div class="section">
                    <div class="section-header">
                        <h3>Bankrolls Criados</h3>
                    </div>
                    <div class="table-responsive">
                        <table>
                            <thead>
                                <tr>
                                    <th>Nome</th>
                                    <th>Categoria</th> 
                                    <th>Saldo Atual (R$)</th>
                                    <th>Ações</th>
                                </tr>
                            </thead>
                            <tbody id="bankrollsTableBody">
                                <tr>
                                    <td colspan="4" class="empty-state">
                                        <div class="empty-state-content">
                                            <i class="fas fa-wallet"></i>
                                            <h3>Nenhum bankroll encontrado</h3>
                                            <p>Crie um novo bankroll para começar.</p>
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div> -->

                <!-- Novo Layout de Cards para Bankrolls -->
                <div class="section bankroll-section">
                    <div id="bankrollCardsContainer" class="bankroll-cards-grid">
                        <!-- Cards serão inseridos aqui pelo JavaScript -->
                        <!-- Exemplo de estado vazio (será tratado pelo JS) -->
                        <!-- 
                        <div class="empty-state full-width-empty-state"> 
                            <div class="empty-state-content">
                                <i class="fas fa-wallet fa-3x"></i>
                                <h3>Nenhum bankroll encontrado</h3>
                                <p>Crie um novo bankroll para começar utilizando o botão "Adicionar Novo Bankroll".</p>
                            </div>
                        </div>
                        -->
                    </div>
                </div>
            </div>
        </main>
    </div>

    <!-- Scripts -->
    <script src="/js/toast-modal.js"></script>
    <script src="/js/main.js"></script>
    <script src="/js/logout.js"></script>
    <script src="/js/bankrolls.js"></script>
    <script src="/js/user-dropdown.js"></script>
</body>
</html>