<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gerenciamento de Apostas</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="css/style.css">
    <link rel="stylesheet" href="css/dashboard.css">
</head>
<body>
    <div class="container">
        <!-- Sidebar -->
        <aside class="sidebar">
            <div class="sidebar-header">
                <h1>BetManager</h1>
                <button id="menu-toggle" class="mobile-menu-btn">
                    <i class="fas fa-bars"></i>
                </button>
            </div>
            <nav class="sidebar-nav">
                <ul>
                    <li class="active">
                        <a href="/dashboard"><i class="fas fa-tachometer-alt"></i> Dashboard</a>
                    </li>
                    <li> 
                        <a href="/casas-de-apostas"><i class="fas fa-home"></i> Casas de Apostas</a>
                    </li>
                    <li> 
                        <a href="/casas-regulamentadas"><i class="fas fa-check-circle"></i> Casas Regulamentadas</a>
                    </li>
                    <li>
                        <a href="/transacoes"><i class="fas fa-exchange-alt"></i> Transações</a>
                    </li>
                    <li>
                        <a href="/bankrolls"><i class="fas fa-wallet"></i> Bankrolls</a>
                    </li>
                    <li>
                        <a href="#relatorios"><i class="fas fa-chart-bar"></i> Relatórios</a>
                    </li>
                    <li>
                        <a href="#configuracoes"><i class="fas fa-cog"></i> Configurações</a>
                    </li>
                    <li class="logout-item">
                        <a href="#" id="logout-btn"><i class="fas fa-sign-out-alt"></i> Logout</a>
                    </li>
                </ul>
            </nav>
            <div class="sidebar-footer">
                <p>© 2025 BetManager</p>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="main-content">
            <header class="main-header">
                <div class="header-search">
                    <input type="text" placeholder="Pesquisar...">
                    <i class="fas fa-search"></i>
                </div>
                <div class="header-user">
                    <div class="notifications">
                        <i class="fas fa-bell"></i>
                        <span class="badge">3</span>
                    </div>
                    <div class="user-profile">
                        <img src="https://via.placeholder.com/40" alt="Profile">
                        <span>Usuário</span>
                    </div>
                </div>
            </header>

            <div class="content-wrapper">
                <!-- Page Title -->
                <div class="page-title">
                    <h2>Dashboard</h2>
                    <div class="date-filter">
                        <select>
                            <option>Hoje</option>
                            <option>Esta Semana</option>
                            <option>Este Mês</option>
                            <option>Este Ano</option>
                        </select>
                    </div>
                </div>

                <!-- Overview Cards -->
                <div class="overview-cards">
                    <div class="card">
                        <div class="card-icon green">
                            <i class="fas fa-wallet"></i>
                        </div>
                        <div class="card-info">
                            <h3>Saldo Total</h3>
                            <p class="card-value">R$ 0,00</p>
                            <p class="card-change">Nenhuma transação</p>
                        </div>
                    </div>
                    <div class="card">
                        <div class="card-icon blue">
                            <i class="fas fa-home"></i>
                        </div>
                        <div class="card-info">
                            <h3>Casas Ativas</h3>
                            <p class="card-value">0</p>
                            <p class="card-change">nenhuma casa cadastrada</p>
                        </div>
                    </div>
                    <div class="card">
                        <div class="card-icon purple">
                            <i class="fas fa-trophy"></i>
                        </div>
                        <div class="card-info">
                            <h3>Maior Saldo</h3>
                            <p class="card-value">-</p>
                            <p class="card-change">R$ 0,00</p>
                        </div>
                    </div>
                    <div class="card">
                        <div class="card-icon orange">
                            <i class="fas fa-chart-line"></i>
                        </div>
                        <div class="card-info">
                            <h3>Rendimento</h3>
                            <p class="card-value">0,0%</p>
                            <p class="card-change">Último mês</p>
                        </div>
                    </div>
                </div>

                <!-- Betting Houses Section -->
                <div class="section">
                    <div class="section-header">
                        <h3>Casas de Apostas</h3>
                        <button class="btn-primary"><i class="fas fa-plus"></i> Adicionar Casa</button>
                    </div>
                    <div class="betting-houses">
                        <div class="empty-state">
                            <i class="fas fa-home"></i>
                            <h3>Nenhuma casa de aposta cadastrada</h3>
                            <p>Clique no botão "Adicionar Casa" para começar</p>
                        </div>
                    </div>
                </div>

                <!-- Recent Transactions -->
                <div class="section">
                    <div class="section-header">
                        <h3>Transações Recentes</h3>
                        <a href="/transacoes" class="btn-text">Ver Todas <i class="fas fa-arrow-right"></i></a>
                    </div>
                    <div class="transactions-table">
                        <table>
                            <thead>
                                <tr>
                                    <th>Data</th>
                                    <th>Casa</th>
                                    <th>Tipo</th>
                                    <th>Valor</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td colspan="5" class="empty-transactions">
                                        <div class="empty-state">
                                            <i class="fas fa-exchange-alt"></i>
                                            <h3>Nenhuma transação registrada</h3>
                                            <p>As transações aparecerão aqui</p>
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <!-- Modal para adicionar casa de aposta -->
    <div id="addHouseModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h2>Adicionar Casa de Aposta</h2>
                <span class="close-modal">&times;</span>
            </div>
            <div class="modal-body">
                <form id="addHouseForm">
                    <div class="form-group">
                        <label for="houseName">Nome da Casa</label>
                        <div class="custom-dropdown">
                            <input type="text" id="houseName" name="houseName" placeholder="Ex: Bet365" required autocomplete="off">
                            <div class="dropdown-content" id="houseNameDropdown">
                                <!-- Lista será preenchida via JavaScript -->
                            </div>
                        </div>
                    </div>
                    <div class="form-group" style="display: none;">
                        <input type="hidden" id="houseLogo" name="houseLogo">
                    </div>
                    <div class="form-group">
                        <label for="initialBalance">Saldo Inicial</label>
                        <input type="number" id="initialBalance" name="initialBalance" placeholder="0.00" step="0.01" min="0">
                    </div>
                    <div class="form-actions">
                        <button type="button" class="btn-outline" id="cancelAddHouse">Cancelar</button>
                        <button type="submit" class="btn-primary">Salvar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    
    <!-- Modal para editar saldo -->
    <div id="editBalanceModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h2>Editar Saldo</h2>
                <span class="close-modal">&times;</span>
            </div>
            <div class="modal-body">
                <form id="editBalanceForm">
                    <input type="hidden" id="editHouseId">
                    <div class="house-info-display">
                        <img id="editHouseLogo" src="https://via.placeholder.com/50" alt="Logo">
                        <h3 id="editHouseName">Nome da Casa</h3>
                    </div>
                    <div class="form-group">
                        <label for="currentBalance">Saldo Atual</label>
                        <input type="text" id="currentBalance" disabled>
                    </div>
                    <div class="form-group">
                        <label for="newBalance">Novo Saldo</label>
                        <input type="number" id="newBalance" name="newBalance" placeholder="0.00" step="0.01" min="0" required>
                        <small>Informe o valor total do saldo</small>
                    </div>
                    <div class="form-group">
                        <label for="balanceNote">Observação (opcional)</label>
                        <textarea id="balanceNote" name="balanceNote" placeholder="Motivo da alteração" rows="2"></textarea>
                    </div>
                    <div class="form-actions">
                        <button type="button" class="btn-outline" id="cancelEditBalance">Cancelar</button>
                        <button type="submit" class="btn-primary">Atualizar Saldo</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    
    <!-- Modal para Depósito -->
    <div id="depositModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h2>Realizar Depósito</h2>
                <span class="close-modal">&times;</span>
            </div>
            <div class="modal-body">
                <form id="depositForm">
                    <input type="hidden" id="depositHouseId">
                    <div class="house-info-display">
                        <img id="depositHouseLogo" src="https://via.placeholder.com/50" alt="Logo">
                        <h3 id="depositHouseName">Nome da Casa</h3>
                    </div>
                    <div class="form-group">
                        <label for="depositAmount">Valor do Depósito</label>
                        <input type="number" id="depositAmount" name="depositAmount" placeholder="0.00" step="0.01" min="0.01" required>
                    </div>
                    <div class="form-group">
                        <label for="depositDescription">Descrição (opcional)</label>
                        <textarea id="depositDescription" name="depositDescription" placeholder="Ex: Bônus de depósito" rows="2"></textarea>
                    </div>
                    <div class="form-actions">
                        <button type="button" class="btn-outline" id="cancelDeposit">Cancelar</button>
                        <button type="submit" class="btn-primary">Confirmar Depósito</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal para Saque -->
    <div id="withdrawModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h2>Realizar Saque</h2>
                <span class="close-modal">&times;</span>
            </div>
            <div class="modal-body">
                <form id="withdrawForm">
                    <input type="hidden" id="withdrawHouseId">
                    <div class="house-info-display">
                        <img id="withdrawHouseLogo" src="https://via.placeholder.com/50" alt="Logo">
                        <h3 id="withdrawHouseName">Nome da Casa</h3>
                    </div>
                    <div class="form-group">
                        <label for="withdrawAmount">Valor do Saque</label>
                        <input type="number" id="withdrawAmount" name="withdrawAmount" placeholder="0.00" step="0.01" min="0.01" required>
                    </div>
                     <div class="form-group">
                        <label for="withdrawDescription">Descrição (opcional)</label>
                        <textarea id="withdrawDescription" name="withdrawDescription" placeholder="Ex: Saque para conta" rows="2"></textarea>
                    </div>
                    <div class="form-actions">
                        <button type="button" class="btn-outline" id="cancelWithdraw">Cancelar</button>
                        <button type="submit" class="btn-primary">Confirmar Saque</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Overlay para o fundo escuro -->
    <div id="modalOverlay" class="modal-overlay"></div>
    
    <script src="js/main.js"></script>
    <script src="js/logout.js"></script>
    <script src="js/dashboard.js"></script>
</body>
</html>