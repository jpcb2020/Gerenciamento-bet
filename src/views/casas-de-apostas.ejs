<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Casas de Apostas - BetManager</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="container">
        <!-- Sidebar -->
        <aside class="sidebar">
            <div class="sidebar-header">
                <h1>BetManager</h1>
                <button id="menu-toggle" class="mobile-menu-btn">
                    <i class="fas fa-bars"></i>
                </button>
            </div>
            <nav class="sidebar-nav">
                <ul>
                    <li>
                        <a href="/"><i class="fas fa-tachometer-alt"></i> Dashboard</a>
                    </li>
                    <li class="active"> 
                        <a href="/casas-de-apostas"><i class="fas fa-home"></i> Casas de Apostas</a>
                    </li>
                    <li> 
                        <a href="#transacoes"><i class="fas fa-exchange-alt"></i> Transações</a>
                    </li>
                    <li>
                        <a href="#relatorios"><i class="fas fa-chart-bar"></i> Relatórios</a>
                    </li>
                    <li>
                        <a href="#configuracoes"><i class="fas fa-cog"></i> Configurações</a>
                    </li>
                </ul>
            </nav>
            <div class="sidebar-footer">
                <p>© 2025 BetManager</p>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="main-content">
            <header class="main-header">
                <div class="header-search">
                    <input type="text" placeholder="Pesquisar casas...">
                    <i class="fas fa-search"></i>
                </div>
                <div class="header-user">
                    <div class="notifications">
                        <i class="fas fa-bell"></i>
                        <span class="badge">0</span> 
                    </div>
                    <div class="user-profile">
                        <img src="https://via.placeholder.com/40" alt="Profile">
                        <span>Usuário</span>
                    </div>
                </div>
            </header>

            <div class="content-wrapper">
                <!-- Page Title -->
                <div class="page-title">
                    <h2>Casas de Apostas</h2>
                    <button class="btn-primary" id="addHouseBtnDetailed"><i class="fas fa-plus"></i> Adicionar Nova Casa</button>
                </div>

                <!-- Detailed Betting Houses Display Area -->
                <div id="detailedCasasGrid" class="detailed-casas-grid">
                    <!-- Casa items will be dynamically inserted here -->
                </div>
                 <div class="empty-state" id="detailedCasasEmptyState" style="display: none;">
                    <i class="fas fa-home"></i>
                    <h3>Nenhuma casa de aposta cadastrada</h3>
                    <p>Clique no botão "Adicionar Nova Casa" para começar</p>
                </div>
            </div>
        </main>
    </div>

    <!-- Modals -->
    <div id="addHouseModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h2>Adicionar Casa de Aposta</h2>
                <span class="close-modal" data-modal-id="addHouseModal">&times;</span>
            </div>
            <div class="modal-body">
                <form id="addHouseForm">
                    <div class="form-group">
                        <label for="houseName">Nome da Casa</label>
                        <input type="text" id="houseName" name="houseName" placeholder="Ex: Bet365" required>
                    </div>
                    <div class="form-group">
                        <label for="houseLogo">URL do Logo (opcional)</label>
                        <input type="text" id="houseLogo" name="houseLogo" placeholder="URL da imagem">
                        <small>Deixe em branco para usar um logo padrão: /images/default-logo.png</small>
                    </div>
                    <div class="form-group">
                        <label for="initialBalance">Saldo Inicial</label>
                        <input type="number" id="initialBalance" name="initialBalance" placeholder="0.00" step="0.01" value="0">
                    </div>
                    <div class="form-actions">
                        <button type="button" class="btn-outline" data-modal-id="addHouseModal" id="cancelAddHouse">Cancelar</button>
                        <button type="submit" class="btn-primary">Salvar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    
    <div id="editHouseModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h2>Editar Casa de Aposta</h2>
                <span class="close-modal" data-modal-id="editHouseModal">&times;</span>
            </div>
            <div class="modal-body">
                <form id="editHouseFormDetailed">
                    <input type="hidden" id="editHouseIdDetailed">
                    <div class="form-group">
                        <label for="editHouseNameDetailed">Nome da Casa</label>
                        <input type="text" id="editHouseNameDetailed" name="houseName" required>
                    </div>
                    <div class="form-group">
                        <label for="editHouseLogoDetailed">URL do Logo</label>
                        <input type="text" id="editHouseLogoDetailed" name="houseLogo" placeholder="URL da imagem ou /images/default-logo.png">
                         <small>Deixe em branco para manter o logo atual ou use /images/default-logo.png para o padrão.</small>
                    </div>
                    <div class="form-group">
                        <label for="editHouseBalanceDetailed">Saldo</label>
                        <input type="number" id="editHouseBalanceDetailed" name="initialBalance" placeholder="0.00" step="0.01" min="0" required>
                    </div>
                    <div class="form-actions">
                        <button type="button" class="btn-outline" data-modal-id="editHouseModal" id="cancelEditHouseDetailed">Cancelar</button>
                        <button type="submit" class="btn-primary">Salvar Alterações</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal para confirmação de exclusão -->
    <div id="deleteConfirmModal" class="confirm-modal-overlay">
        <div class="confirm-modal">
            <div class="confirm-modal-icon">
                <i class="fas fa-trash-alt" style="color: var(--red-color);"></i>
            </div>
            <h2 class="confirm-modal-title">Confirmar Exclusão</h2>
            <p class="confirm-modal-message">Tem certeza de que deseja excluir a casa "<span id="deleteCasaName"></span>"? Esta ação não pode ser desfeita.<br></p>
            <div class="confirm-modal-actions">
                 <button type="button" class="btn btn-secondary" id="cancelDeleteHouse">Cancelar</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteHouseBtn">Excluir</button>
            </div>
        </div>
    </div>

    <!-- Modal para Depósito -->
    <div id="depositModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h2>Realizar Depósito</h2>
                <span class="close-modal" data-modal-id="depositModal">&times;</span>
            </div>
            <div class="modal-body">
                <form id="depositForm">
                    <input type="hidden" id="depositHouseId">
                    <div class="house-info-display">
                        <img id="depositHouseLogo" src="https://via.placeholder.com/50" alt="Logo">
                        <h3 id="depositHouseName">Nome da Casa</h3>
                    </div>
                    <div class="form-group">
                        <label for="depositAmount">Valor do Depósito</label>
                        <input type="number" id="depositAmount" name="depositAmount" placeholder="0.00" step="0.01" min="0.01" required>
                    </div>
                    <div class="form-group">
                        <label for="depositDescription">Descrição (opcional)</label>
                        <textarea id="depositDescription" name="depositDescription" placeholder="Ex: Bônus de depósito" rows="2"></textarea>
                    </div>
                    <div class="form-actions">
                        <button type="button" class="btn-outline" id="cancelDeposit">Cancelar</button>
                        <button type="submit" class="btn-primary">Confirmar Depósito</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal para Saque -->
    <div id="withdrawModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h2>Realizar Saque</h2>
                <span class="close-modal" data-modal-id="withdrawModal">&times;</span>
            </div>
            <div class="modal-body">
                <form id="withdrawForm">
                    <input type="hidden" id="withdrawHouseId">
                    <div class="house-info-display">
                        <img id="withdrawHouseLogo" src="https://via.placeholder.com/50" alt="Logo">
                        <h3 id="withdrawHouseName">Nome da Casa</h3>
                    </div>
                    <div class="form-group">
                        <label for="withdrawAmount">Valor do Saque</label>
                        <input type="number" id="withdrawAmount" name="withdrawAmount" placeholder="0.00" step="0.01" min="0.01" required>
                    </div>
                     <div class="form-group">
                        <label for="withdrawDescription">Descrição (opcional)</label>
                        <textarea id="withdrawDescription" name="withdrawDescription" placeholder="Ex: Saque para conta" rows="2"></textarea>
                    </div>
                    <div class="form-actions">
                        <button type="button" class="btn-outline" id="cancelWithdraw">Cancelar</button>
                        <button type="submit" class="btn-primary">Confirmar Saque</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div id="modalOverlay" class="modal-overlay"></div>

    <div id="toast-container"></div>
    
    <script src="/js/casas-de-apostas.js"></script>
    <script src="/js/modalHandler.js"></script>
    <script src="/js/main.js"></script>
</body>
</html> 