<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="/css/login.css">
    <link rel="stylesheet" href="/css/forgot-password.css">
</head>
<body>
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-4">
                <div class="login-container">
                    <div class="login-header">
                        <i class="fas fa-lock fa-2x mb-3"></i>
                        <h2>BetManager</h2>
                        <div class="subtitle">Redefinir Senha</div>
                        <% if (!error && token) { %>
                            <p class="text-muted small mt-2">
                                Digite sua nova senha abaixo.
                            </p>
                        <% } %>
                    </div>
                    
                    <div class="login-body">
                        <div id="alert-container"></div>
                        
                        <% if (error) { %>
                            <div class="alert alert-danger">
                                <i class="fas fa-exclamation-triangle me-2"></i>
                                <%= error %>
                            </div>
                            <div class="text-center">
                                <a href="/forgot-password" class="btn btn-primary">
                                    <i class="fas fa-redo me-2"></i>Solicitar Novo Link
                                </a>
                                <div class="mt-3">
                                    <a href="/login" class="text-muted">Voltar ao Login</a>
                                </div>
                            </div>
                        <% } else if (token) { %>
                            <form id="resetPasswordForm">
                                <input type="hidden" id="token" value="<%= token %>">
                                
                                <div class="form-floating">
                                    <input type="password" class="form-control" id="newPassword" name="newPassword" 
                                           placeholder="Nova senha" required minlength="6" style="padding-right: 45px;">
                                    <label for="newPassword"><i class="fas fa-lock me-2"></i>Nova Senha</label>
                                    <span class="password-toggle" onclick="togglePassword('newPassword', 'toggleIcon1')">
                                        <i class="fas fa-eye" id="toggleIcon1"></i>
                                    </span>
                                </div>
                                
                                <div class="form-floating">
                                    <input type="password" class="form-control" id="confirmPassword" name="confirmPassword" 
                                           placeholder="Confirmar senha" required minlength="6" style="padding-right: 45px;">
                                    <label for="confirmPassword"><i class="fas fa-lock me-2"></i>Confirmar Senha</label>
                                    <span class="password-toggle" onclick="togglePassword('confirmPassword', 'toggleIcon2')">
                                        <i class="fas fa-eye" id="toggleIcon2"></i>
                                    </span>
                                </div>
                                
                                <!-- Indicador de força da senha -->
                                <div class="password-strength mt-2">
                                    <small class="text-muted">Força da senha:</small>
                                    <div class="progress" style="height: 5px;">
                                        <div class="progress-bar" id="strengthBar" role="progressbar" style="width: 0%"></div>
                                    </div>
                                    <small id="strengthText" class="text-muted">Digite uma senha</small>
                                </div>
                                
                                <!-- Requisitos da senha -->
                                <div class="password-requirements mt-3">
                                    <small class="text-muted d-block mb-1">Requisitos da senha:</small>
                                    <div class="requirement" id="req-length">
                                        <i class="fas fa-times text-danger me-1"></i>
                                        <small>Pelo menos 6 caracteres</small>
                                    </div>
                                    <div class="requirement" id="req-number">
                                        <i class="fas fa-times text-danger me-1"></i>
                                        <small>Pelo menos 1 número</small>
                                    </div>
                                    <div class="requirement" id="req-letter">
                                        <i class="fas fa-times text-danger me-1"></i>
                                        <small>Pelo menos 1 letra</small>
                                    </div>
                                </div>
                                
                                <button type="submit" class="btn btn-primary btn-login" id="resetPasswordBtn">
                                    <span class="spinner-border spinner-border-sm me-2 d-none" id="resetPasswordSpinner"></span>
                                    <i class="fas fa-save me-2"></i>
                                    Redefinir Senha
                                </button>
                            </form>
                        <% } %>
                        
                        <div class="reset-footer mt-4">
                            <div class="register-link text-center">
                                <p class="mb-0">Lembrou da senha? <a href="/login">Fazer login</a></p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal de sucesso -->
    <div class="modal fade" id="successModal" tabindex="-1" aria-labelledby="successModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header border-0">
                    <h5 class="modal-title text-success" id="successModalLabel">
                        <i class="fas fa-check-circle me-2"></i>Senha Redefinida!
                    </h5>
                </div>
                <div class="modal-body text-center">
                    <div class="mb-3">
                        <i class="fas fa-shield-alt fa-3x text-success mb-3"></i>
                    </div>
                    <p class="mb-3">
                        Sua senha foi redefinida com sucesso! 
                        Agora você pode fazer login com sua nova senha.
                    </p>
                </div>
                <div class="modal-footer border-0 justify-content-center">
                    <a href="/login" class="btn btn-success">
                        <i class="fas fa-sign-in-alt me-2"></i>Fazer Login
                    </a>
                </div>
            </div>
        </div>
    </div>
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/reset-password.js"></script>
</body>
</html> 