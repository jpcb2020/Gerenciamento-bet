<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Notas e Lembretes - BetManager</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/notas.css">
</head>
<body>
    <div class="container">
        <!-- Sidebar -->
        <aside class="sidebar">
            <div class="sidebar-header">
                <h1>BetManager</h1>
                <button id="menu-toggle" class="mobile-menu-btn">
                    <i class="fas fa-bars"></i>
                </button>
            </div>
            <nav class="sidebar-nav">
                <ul>
                    <li>
                        <a href="/dashboard"><i class="fas fa-tachometer-alt"></i> Dashboard</a>
                    </li>
                    <li> 
                        <a href="/casas-de-apostas"><i class="fas fa-home"></i> Casas de Apostas</a>
                    </li>
                    <li> 
                        <a href="/casas-regulamentadas"><i class="fas fa-check-circle"></i> Casas Regulamentadas</a>
                    </li>
                    <li>
                        <a href="/transacoes"><i class="fas fa-exchange-alt"></i> Transações</a>
                    </li>
                    <li>
                        <a href="/bankrolls"><i class="fas fa-wallet"></i> Bankrolls</a>
                    </li>
                    <li>
                        <a href="/bonus-promocoes"><i class="fas fa-gift"></i> Bônus e Promoções</a>
                    </li>
                    <li class="active">
                        <a href="/notas"><i class="fas fa-sticky-note"></i> Notas e Lembretes</a>
                    </li>
                    <li>
                        <a href="/relatorios"><i class="fas fa-chart-bar"></i> Relatórios</a>
                    </li>
                    <li>
                        <a href="#configuracoes"><i class="fas fa-cog"></i> Configurações</a>
                    </li>
                    <li class="logout-item">
                        <a href="#" id="logout-btn"><i class="fas fa-sign-out-alt"></i> Logout</a>
                    </li>
                </ul>
            </nav>
            <div class="sidebar-footer">
                <p>© 2025 BetManager</p>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="main-content">
            <header class="main-header">
                <div class="header-search">
                    <input type="text" id="searchNotas" placeholder="Pesquisar notas e lembretes...">
                    <i class="fas fa-search"></i>
                </div>
                <div class="header-user">
                    <div class="notifications">
                        <i class="fas fa-bell"></i>
                        <span class="badge">0</span> 
                    </div>
                    <div class="user-profile" id="userProfile">
                        <div class="user-avatar-placeholder">
                            <i class="fas fa-user"></i>
                        </div>
                        <span><%= user.nome || 'Usuário' %></span>
                        <i class="fas fa-chevron-down" style="margin-left: 8px; font-size: 0.8rem; color: var(--text-light);"></i>
                        
                        <!-- Dropdown Menu -->
                        <div class="user-dropdown" id="userDropdown">
                            <div class="dropdown-header">
                                <div class="user-avatar-placeholder" style="margin: 0 auto 10px; width: 50px; height: 50px;">
                                    <i class="fas fa-user" style="font-size: 22px;"></i>
                                </div>
                                <div class="dropdown-user-info">
                                    <h4><%= user.nome %> <%= user.sobrenome || '' %></h4>
                                    <p><%= user.email %></p>
                                </div>
                            </div>
                            <div class="dropdown-menu">
                                <a href="/profile" class="dropdown-item">
                                    <i class="fas fa-user-cog"></i>
                                    Meu Perfil
                                </a>
                                <a href="#" class="dropdown-item">
                                    <i class="fas fa-cog"></i>
                                    Configurações
                                </a>
                                <a href="#" class="dropdown-item">
                                    <i class="fas fa-chart-bar"></i>
                                    Relatórios
                                </a>
                                <div class="dropdown-divider"></div>
                                <a href="#" class="dropdown-item">
                                    <i class="fas fa-question-circle"></i>
                                    Ajuda
                                </a>
                                <div class="dropdown-divider"></div>
                                <button class="dropdown-item logout" id="logoutBtn">
                                    <i class="fas fa-sign-out-alt"></i>
                                    Logout
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </header>

            <div class="content-wrapper">
                <!-- Page Title -->
                <div class="page-title">
                    <h2>Notas e Lembretes</h2>
                    <button class="btn-primary" id="addNotaBtn">
                        <i class="fas fa-plus"></i> Nova Nota/Lembrete
                    </button>
                </div>

                <!-- Filters -->
                <div class="notas-filters">
                    <div class="filter-group">
                        <label for="filterTipo">Tipo:</label>
                        <select id="filterTipo" class="filter-control">
                            <option value="">Todos</option>
                            <option value="nota">Notas</option>
                            <option value="lembrete">Lembretes</option>
                        </select>
                    </div>
                    <div class="filter-group">
                        <label for="filterPrioridade">Prioridade:</label>
                        <select id="filterPrioridade" class="filter-control">
                            <option value="">Todas</option>
                            <option value="alta">Alta</option>
                            <option value="media">Média</option>
                            <option value="baixa">Baixa</option>
                        </select>
                    </div>
                    <div class="filter-group">
                        <label for="filterStatus">Status:</label>
                        <select id="filterStatus" class="filter-control">
                            <option value="">Todos</option>
                            <option value="false">Pendentes</option>
                            <option value="true">Concluídos</option>
                        </select>
                    </div>
                </div>

                <!-- Notas Grid -->
                <div id="notasGrid" class="notas-grid">
                    <!-- Notas serão carregadas dinamicamente -->
                </div>

                <!-- Empty State -->
                <div class="empty-state" id="notasEmptyState" style="display: none;">
                    <i class="fas fa-sticky-note"></i>
                    <h3>Nenhuma nota encontrada</h3>
                    <p>Clique no botão "Nova Nota/Lembrete" para começar</p>
                </div>
            </div>
        </main>
    </div>

    <!-- Modal para Adicionar/Editar Nota -->
    <div id="notaModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h2 id="modalTitle">Nova Nota/Lembrete</h2>
                <span class="close-modal" id="closeNotaModal">&times;</span>
            </div>
            <div class="modal-body">
                <form id="notaForm">
                    <input type="hidden" id="notaId">
                    
                    <div class="form-group">
                        <label for="notaTitulo">Título <span class="required">*</span></label>
                        <input type="text" id="notaTitulo" name="titulo" required maxlength="255">
                    </div>

                    <div class="form-group">
                        <label for="notaTipo">Tipo <span class="required">*</span></label>
                        <select id="notaTipo" name="tipo" required>
                            <option value="">Selecione...</option>
                            <option value="nota">📝 Nota</option>
                            <option value="lembrete">⏰ Lembrete</option>
                        </select>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label for="notaPrioridade">Prioridade</label>
                            <select id="notaPrioridade" name="prioridade">
                                <option value="baixa">🟢 Baixa</option>
                                <option value="media" selected>🟡 Média</option>
                                <option value="alta">🔴 Alta</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="notaCor">Cor</label>
                            <input type="color" id="notaCor" name="cor" value="#6c5ce7">
                        </div>
                    </div>

                    <div class="form-group" id="dataLembreteGroup" style="display: none;">
                        <label for="dataLembrete">Data/Hora do Lembrete</label>
                        <input type="datetime-local" id="dataLembrete" name="data_lembrete">
                    </div>

                    <div class="form-group">
                        <label for="notaConteudo">Conteúdo <span class="required">*</span></label>
                        <textarea id="notaConteudo" name="conteudo" rows="5" required></textarea>
                    </div>

                    <div class="form-actions">
                        <button type="button" class="btn-outline" id="cancelNotaBtn">Cancelar</button>
                        <button type="submit" class="btn-primary">Salvar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal Overlay -->
    <div id="modalOverlay" class="modal-overlay"></div>

    <!-- Toast Container -->
    <div id="toast-container"></div>

    <script src="/js/user-dropdown.js"></script>
    <script src="/js/logout.js"></script>
    <script src="/js/notas.js"></script>
</body>
</html> 