<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Casas Regulamentadas - BetManager</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/casas-regulamentadas.css">
</head>
<body>
    <div class="container">
        <!-- Sidebar -->
        <aside class="sidebar">
            <div class="sidebar-header">
                <h1>BetManager</h1>
                <button id="menu-toggle" class="mobile-menu-btn">
                    <i class="fas fa-bars"></i>
                </button>
            </div>
            <nav class="sidebar-nav">
                <ul>
                    <li>
                        <a href="/dashboard"><i class="fas fa-tachometer-alt"></i> Dashboard</a>
                    </li>
                    <li>
                        <a href="/casas-de-apostas"><i class="fas fa-home"></i> Casas de Apostas</a>
                    </li>
                    <li class="active"> 
                        <a href="/casas-regulamentadas"><i class="fas fa-check-circle"></i> Casas Regulamentadas</a>
                    </li>
                    <li> 
                        <a href="/transacoes"><i class="fas fa-exchange-alt"></i> Transações</a>
                    </li>
                    <li>
                        <a href="/bankrolls"><i class="fas fa-wallet"></i> Bankrolls</a>
                    </li>
                    <li>
                        <a href="/bonus-promocoes"><i class="fas fa-gift"></i> Bônus e Promoções</a>
                    </li>
                    <li>
                        <a href="/relatorios"><i class="fas fa-chart-bar"></i> Relatórios</a>
                    </li>
                    <li>
                        <a href="#configuracoes"><i class="fas fa-cog"></i> Configurações</a>
                    </li>
                    <li class="logout-item">
                        <a href="#" id="logout-btn"><i class="fas fa-sign-out-alt"></i> Logout</a>
                    </li>
                </ul>
            </nav>
            <div class="sidebar-footer">
                <p>© 2025 BetManager</p>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="main-content">
            <header class="main-header">
                <div class="header-search">
                    <input type="text" id="searchCasas" placeholder="Pesquisar casas...">
                    <i class="fas fa-search"></i>
                </div>
                <div class="header-user">
                    <div class="notifications">
                        <i class="fas fa-bell"></i>
                        <span class="badge">0</span> 
                    </div>
                    <div class="user-profile" id="userProfile">
                        <div class="user-avatar-placeholder">
                            <i class="fas fa-user"></i>
                        </div>
                        <span><%= user.nome || 'Usuário' %></span>
                        <i class="fas fa-chevron-down" style="margin-left: 8px; font-size: 0.8rem; color: var(--text-light);"></i>
                        
                        <!-- Dropdown Menu -->
                        <div class="user-dropdown" id="userDropdown">
                            <div class="dropdown-header">
                                <div class="user-avatar-placeholder" style="margin: 0 auto 10px; width: 50px; height: 50px;">
                                    <i class="fas fa-user" style="font-size: 22px;"></i>
                                </div>
                                <div class="dropdown-user-info">
                                    <h4><%= user.nome %> <%= user.sobrenome || '' %></h4>
                                    <p><%= user.email %></p>
                                </div>
                            </div>
                            <div class="dropdown-menu">
                                <a href="/profile" class="dropdown-item">
                                    <i class="fas fa-user-cog"></i>
                                    Meu Perfil
                                </a>
                                <a href="#" class="dropdown-item">
                                    <i class="fas fa-cog"></i>
                                    Configurações
                                </a>
                                <a href="#" class="dropdown-item">
                                    <i class="fas fa-chart-bar"></i>
                                    Relatórios
                                </a>
                                <div class="dropdown-divider"></div>
                                <a href="#" class="dropdown-item">
                                    <i class="fas fa-question-circle"></i>
                                    Ajuda
                                </a>
                                <div class="dropdown-divider"></div>
                                <button class="dropdown-item logout" id="logoutBtn">
                                    <i class="fas fa-sign-out-alt"></i>
                                    Logout
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </header>

            <div class="content-wrapper">
                <!-- Page Title -->
                <div class="page-title">
                    <h2>Casas de Apostas Regulamentadas no Brasil</h2>
                    <div class="filter-container">
                        <button class="btn-outline filter-btn" id="sortByName"><i class="fas fa-sort-alpha-down"></i> Ordenar por Nome</button>
                        <button class="btn-outline filter-btn" id="sortByCompany"><i class="fas fa-building"></i> Ordenar por Empresa</button>
                        <button class="btn-outline filter-btn exchange-filter" id="filterExchange"><i class="fas fa-exchange-alt"></i> Mostrar Exchange</button>
                    </div>
                </div>

                <div class="page-description">
                    <p>Lista oficial de casas de apostas autorizadas pelo Ministério da Fazenda (SPA/MF) para operação no Brasil a partir de 1º de janeiro de 2025, de acordo com as Leis nº 13.756 e 14.790.</p>
                </div>
                
                <!-- Filtro de Empresas -->
                <div class="company-filter">
                    <label for="companySelect">Filtrar por empresa:</label>
                    <select id="companySelect">
                        <option value="todas">Todas as empresas</option>
                        <!-- Opções serão adicionadas dinamicamente pelo JavaScript -->
                    </select>
                </div>

                <!-- Container para mostrar as casas de apostas regulamentadas -->
                <div id="regCasasContainer" class="reg-casas-container">
                    <!-- O conteúdo será dinamicamente inserido pelo JavaScript -->
                </div>
            </div>
        </main>
    </div>

    <!-- Modal para detalhes da casa -->
    <div id="casaDetailModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h2 id="modalCasaName">Detalhes da Casa</h2>
                <span class="close-modal" data-modal-id="casaDetailModal">&times;</span>
            </div>
            <div class="modal-body">
                <div class="casa-details">
                    <div class="casa-header">
                        <div class="casa-logo">
                            <img id="modalCasaLogo" src="" alt="Logo da casa">
                        </div>
                        <div class="casa-info">
                            <h3 id="modalCasaNome"></h3>
                            <p><strong>Empresa:</strong> <span id="modalCasaEmpresa"></span></p>
                            <p><strong>CNPJ:</strong> <span id="modalCasaCNPJ"></span></p>
                            <p><strong>Site:</strong> <a id="modalCasaSite" href="#" target="_blank"></a></p>
                            <p><strong>Portaria de Autorização:</strong> <span id="modalCasaPortaria"></span></p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a id="modalCasaLink" href="#" class="btn-primary" target="_blank">Visitar Site Oficial</a>
                <button class="btn-outline" data-modal-id="casaDetailModal">Fechar</button>
            </div>
        </div>
    </div>

    <script src="/js/toast-modal.js"></script>
    <script src="/js/main.js"></script>
    <script src="/js/casas-regulamentadas.js"></script>
    <script src="/js/logout.js"></script>
    <script src="/js/user-dropdown.js"></script>
</body>
</html>
