<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Erro - Gerenciamento de Apostas</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .error-container {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 80vh;
            text-align: center;
            padding: 0 20px;
        }
        
        .error-icon {
            font-size: 5rem;
            color: #e74c3c;
            margin-bottom: 20px;
        }
        
        .error-title {
            font-size: 2rem;
            margin-bottom: 10px;
            color: #333;
        }
        
        .error-message {
            font-size: 1.2rem;
            margin-bottom: 30px;
            color: #555;
        }
        
        .error-details {
            background-color: #f8f8f8;
            padding: 15px;
            border-radius: 5px;
            margin-bottom: 30px;
            max-width: 800px;
            overflow-x: auto;
            text-align: left;
        }
        
        .back-btn {
            padding: 10px 20px;
            background-color: #3498db;
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-size: 1rem;
            transition: background-color 0.3s;
        }
        
        .back-btn:hover {
            background-color: #2980b9;
        }
    </style>
</head>
<body>
    <div class="error-container">
        <i class="fas fa-exclamation-triangle error-icon"></i>
        <h1 class="error-title">Oops! Ocorreu um erro</h1>
        <p class="error-message"><%= message %></p>
        
        <% if (error && Object.keys(error).length > 0) { %>
        <div class="error-details">
            <pre><%= JSON.stringify(error, null, 2) %></pre>
        </div>
        <% } %>
        
        <button class="back-btn" onclick="window.history.back()">Voltar à página anterior</button>
        <p style="margin-top: 20px;">
            <a href="/dashboard">Retornar ao Dashboard</a>
        </p>
    </div>
</body>
</html> 