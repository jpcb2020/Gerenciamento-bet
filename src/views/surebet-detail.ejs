    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Funções de manipulação de status definidas no escopo global para serem acessíveis
        function toggleStatusMenu(button) {
            const entryId = button.getAttribute('data-entry-id');
            const menu = document.getElementById(`status-menu-${entryId}`);
            
            // Fechar todos os outros menus abertos
            document.querySelectorAll('.status-menu.show').forEach(openMenu => {
                if (openMenu !== menu) {
                    openMenu.classList.remove('show');
                }
            });
            
            // Determinar se o menu deve abrir para cima ou para baixo
            const buttonRect = button.getBoundingClientRect();
            const windowHeight = window.innerHeight;
            const buttonBottomPosition = buttonRect.bottom;
            
            // Se o botão estiver na metade inferior da tela, abrir o menu para cima
            if (buttonBottomPosition > windowHeight - 150) {
                menu.classList.add('dropdown-up');
            } else {
                menu.classList.remove('dropdown-up');
            }
            
            // Alternar a visibilidade deste menu
            menu.classList.toggle('show');
            
            // Evitar que cliques no menu se propaguem para o documento
            menu.addEventListener('click', (e) => {
                e.stopPropagation();
            });
        }
        
        // Função para atualizar o status de uma entrada
        async function updateEntryStatus(entryId, newStatus, event) {
            if (event) {
                event.preventDefault();
            }
            
            const bankrollId = new URLSearchParams(window.location.search).get('id');
            if (!bankrollId || !entryId) {
                alert('Erro: ID do bankroll ou da entrada não encontrado');
                return;
            }
            
            try {
                const response = await fetch(`/api/surebet/entries/${bankrollId}/${entryId}/status`, {
                    method: 'PATCH',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ status: newStatus })
                });
                
                const contentType = response.headers.get('content-type');
                
                if (!response.ok) {
                    let errorMessage = 'Erro ao atualizar status';
                    
                    if (contentType && contentType.includes('application/json')) {
                        try {
                            const errorData = await response.json();
                            errorMessage = errorData.msg || errorMessage;
                        } catch (parseError) {
                            console.error('Erro ao analisar resposta JSON:', parseError);
                            errorMessage = `${errorMessage} (${response.status})`;
                        }
                    } else {
                        errorMessage = `${errorMessage}: API retornou ${response.status}`;
                    }
                    
                    throw new Error(errorMessage);
                }
                
                // Atualizar a UI sem precisar recarregar toda a tabela
                const dropdown = document.querySelector(`button.dropdown-toggle[data-entry-id="${entryId}"]`);
                if (dropdown) {
                    // Atualizar texto e classe CSS do botão
                    // Remover todas as classes de status anteriores
                    dropdown.classList.remove('status-pendente', 'status-resolvido', 'status-cancelado');
                    // Adicionar a nova classe de status
                    dropdown.classList.add(`status-${newStatus.toLowerCase()}`);
                    // Atualizar o texto
                    dropdown.innerHTML = `${newStatus}<i class="fas fa-chevron-down ml-1"></i>`;
                    
                    // Atualizar a classe da linha da tabela
                    const row = dropdown.closest('tr');
                    if (row) {
                        row.classList.remove('status-pendente-row', 'status-resolvido-row', 'status-cancelado-row');
                        row.classList.add(`status-${newStatus.toLowerCase()}-row`);
                    }
                    
                    // Fechar o menu de dropdown
                    const menu = document.getElementById(`status-menu-${entryId}`);
                    if (menu) {
                        menu.classList.remove('show');
                    }
                }
                
                console.log(`Status da entrada ${entryId} atualizado para ${newStatus}`);
            } catch (error) {
                console.error('Erro ao atualizar status:', error);
                alert(`Erro ao atualizar status: ${error.message}`);
            }
        }
        
        document.addEventListener('DOMContentLoaded', function() {
            const bankrollId = new URLSearchParams(window.location.search).get('id');

            // Formatação de moeda e data
            const formatCurrency = (value) => {
                return parseFloat(value).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
            };
            const formatDate = (dateString) => {
                if (!dateString) return 'N/A';
                const date = new Date(dateString);
                return date.toLocaleDateString('pt-BR', { day: '2-digit', month: '2-digit', year: 'numeric' }) + ' ' + 
                       date.toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' });
            };

            // Função para buscar e renderizar entradas de surebet
            async function fetchSurebetEntries(filters = {}) {
                if (!bankrollId) return;

                const entriesTableBody = document.getElementById('entriesTableBody');
                entriesTableBody.innerHTML = `
                    <tr class="loading-state-row">
                        <td colspan="8" class="loading-state">
                            <i class="fas fa-spinner fa-spin"></i>
                            <p>Carregando entradas...</p>
                        </td>
                    </tr>`;

                try {
                    let apiUrl = `/api/surebet/entries/${bankrollId}`;
                    const queryParams = new URLSearchParams();
                    if (filters.period) queryParams.append('period', filters.period);
                    if (filters.status) queryParams.append('status', filters.status);
                    if (filters.search) queryParams.append('search', filters.search);
                    
                    if (queryParams.toString()) {
                        apiUrl += `?${queryParams.toString()}`;
                    }

                    const response = await fetch(apiUrl);
                    if (!response.ok) {
                        const errorData = await response.json();
                        throw new Error(errorData.msg || 'Erro ao buscar entradas de surebet');
                    }
                    const entries = await response.json();
                    renderEntriesTable(entries);
                } catch (error) {
                    console.error('Erro ao buscar entradas:', error);
                    entriesTableBody.innerHTML = `
                        <tr class="error-state-row">
                            <td colspan="8" class="empty-state">
                                <div class="empty-state-content">
                                    <i class="fas fa-exclamation-triangle"></i>
                                    <h3>Erro ao carregar entradas</h3>
                                    <p>${error.message}</p>
                                </div>
                            </td>
                        </tr>`;
                }
            }

            // Função para alternar o estado expandido/recolhido de uma linha
            function toggleRowExpansion(row) {
                row.classList.toggle('collapsed');
                const expandIcon = row.querySelector('.expand-toggle i');
                if (row.classList.contains('collapsed')) {
                    expandIcon.classList.remove('fa-chevron-down');
                    expandIcon.classList.add('fa-chevron-right');
                } else {
                    expandIcon.classList.remove('fa-chevron-right');
                    expandIcon.classList.add('fa-chevron-down');
                }
            }
            
            function renderEntriesTable(entries) {
                const entriesTableBody = document.getElementById('entriesTableBody');
                entriesTableBody.innerHTML = ''; // Limpar conteúdo

                if (entries.length === 0) {
                    entriesTableBody.innerHTML = `
                        <tr class="empty-state-row">
                            <td colspan="8" class="empty-state">
                                <div class="empty-state-content">
                                    <i class="fas fa-list"></i>
                                    <h3>Nenhuma entrada encontrada</h3>
                                    <p>Adicione uma nova entrada usando o botão "Nova Entrada" ou ajuste os filtros.</p>
                                </div>
                            </td>
                        </tr>`;
                    return;
                }

                entries.forEach(entry => {
                    const valorTotalApostado = entry.bets.reduce((sum, b) => sum + parseFloat(b.valor_apostado), 0);
                    const roiClass = parseFloat(entry.roi_percentual) >= 0 ? 'text-success' : 'text-danger';
                    const roiValue = entry.roi_percentual ? parseFloat(entry.roi_percentual).toFixed(2) + '%' : 'N/A';
                    
                    // Renderizar apostas e odds
                    let betsHtml = '';
                    entry.bets.forEach((bet, index) => {
                        // Se não for a primeira aposta, adicionar um separador
                        if (index > 0) {
                            betsHtml += '<div class="bet-divider"></div>';
                        }
                        
                        betsHtml += `
                            <div class="bet-item">
                                <div class="bet-house">${bet.casa_apostas}:</div>
                                <div class="bet-info">
                                    <span class="bet-market">${bet.mercado}</span>
                                    <span class="bet-odds">${parseFloat(bet.odds).toFixed(2)}</span>
                                </div>
                                ${bet.status_aposta && bet.status_aposta.toLowerCase() !== 'pendente' ? 
                                    `<div class="bet-status-badge ${bet.status_aposta.toLowerCase() === 'ganhou' ? 'status-win' : 'status-lose'}">
                                        ${bet.status_aposta}
                                    </div>` : ''
                                }
                            </div>`;
                    });
                    
                    // Criar linha da tabela
                    const row = document.createElement('tr');
                    row.className = `entry-row collapsed status-${entry.status ? entry.status.toLowerCase() : 'pendente'}-row`;
                    
                    row.innerHTML = `
                        <td class="entry-date">
                            <span class="expand-toggle" title="Expandir/Recolher detalhes"><i class="fas fa-chevron-right"></i></span>
                            ${formatDate(entry.data_evento)}
                        </td>
                        <td class="entry-event">
                            <div class="event-name">${entry.evento}</div>
                            ${entry.competicao ? `<div class="event-competition">${entry.competicao}</div>` : ''}
                        </td>
                        <td class="entry-bets">
                            <div class="bets-container">
                                ${betsHtml}
                            </div>
                        </td>
                        <td class="entry-stake">${formatCurrency(valorTotalApostado)}</td>
                        <td class="entry-return">${formatCurrency(entry.retorno_total)}</td>
                        <td class="entry-profit ${parseFloat(entry.lucro_total) >= 0 ? 'text-success' : 'text-danger'}">
                            ${formatCurrency(entry.lucro_total)}
                            <span class="roi-badge ${roiClass}">${roiValue}</span>
                        </td>
                        <td class="entry-status">
                            <div class="status-dropdown">
                                <button class="status-tag status-${entry.status ? entry.status.toLowerCase() : 'pendente'} dropdown-toggle" data-entry-id="${entry.id}" onclick="toggleStatusMenu(this)">
                                    ${entry.status || 'Pendente'}
                                    <i class="fas fa-chevron-down ml-1"></i>
                                </button>
                                <div class="status-menu" id="status-menu-${entry.id}">
                                    <a href="#" class="status-option" data-status="Pendente" onclick="updateEntryStatus(${entry.id}, 'Pendente', event)">Pendente</a>
                                    <a href="#" class="status-option" data-status="Resolvido" onclick="updateEntryStatus(${entry.id}, 'Resolvido', event)">Resolvido</a>
                                    <a href="#" class="status-option" data-status="Cancelado" onclick="updateEntryStatus(${entry.id}, 'Cancelado', event)">Cancelado</a>
                                </div>
                            </div>
                        </td>
                        <td class="entry-actions">
                            <div class="action-buttons">
                                <button class="btn-icon btn-xs" title="Ver Detalhes" data-entry-id="${entry.id}"><i class="fas fa-eye"></i></button>
                                <button class="btn-icon btn-xs" title="Editar" data-entry-id="${entry.id}"><i class="fas fa-edit"></i></button>
                                <button class="btn-icon btn-xs" title="Excluir" data-entry-id="${entry.id}"><i class="fas fa-trash"></i></button>
                            </div>
                        </td>
                    `;
                    
                    entriesTableBody.appendChild(row);
                    
                    // Adiciona o event listener para o botão de excluir
                    const deleteButton = row.querySelector('button[title="Excluir"]');
                    if (deleteButton) {
                        deleteButton.addEventListener('click', function() {
                            deleteSurebetEntry(entry.id);
                        });
                    }
                    
                    // Adicionar listener para o botão de expandir/recolher
                    const expandToggle = row.querySelector('.expand-toggle');
                    if (expandToggle) {
                        expandToggle.addEventListener('click', function(e) {
                            e.stopPropagation(); // Impedir que o clique propague para a linha
                            toggleRowExpansion(row);
                        });
                    }
                });
            }

            // Inicialização das tabs
            const tabButtons = document.querySelectorAll('.tab-btn');
            const tabPanes = document.querySelectorAll('.tab-pane');

            tabButtons.forEach(button => {
                button.addEventListener('click', () => {
                    const tabTarget = button.dataset.tab;
                    
                    tabButtons.forEach(btn => btn.classList.remove('active'));
                    button.classList.add('active');
                    
                    tabPanes.forEach(pane => {
                        pane.classList.toggle('active', pane.id === tabTarget + 'Tab');
                    });

                    if (tabTarget === 'entries') {
                        fetchSurebetEntries(); // Carregar entradas ao abrir a aba
                    }
                });
            });

            // Manipulação do modal de nova entrada
            const newEntryModal = document.getElementById('newEntryModal');
            const addSurebetEntryBtn = document.getElementById('addSurebetEntryBtn');
            const closeModalBtn = document.querySelector('.modal .close-modal');
            const cancelEntryBtn = document.getElementById('cancelEntryBtn');

            addSurebetEntryBtn.addEventListener('click', () => {
                newEntryModal.classList.add('active');
            });

            closeModalBtn.addEventListener('click', () => {
                newEntryModal.classList.remove('active');
            });

            cancelEntryBtn.addEventListener('click', () => {
                newEntryModal.classList.remove('active');
            });

            window.addEventListener('click', (event) => {
                if (event.target === newEntryModal) {
                    newEntryModal.classList.remove('active');
                }
            });

            // Botão para adicionar mais apostas no formulário
            const addMoreBetBtn = document.getElementById('addMoreBetBtn');
            const entryBetsContainer = document.getElementById('entryBetsContainer');
            let betCount = 2;

            addMoreBetBtn.addEventListener('click', () => {
                betCount++;
                const newBet = document.createElement('div');
                newBet.className = 'entry-bet';
                newBet.innerHTML = `
                    <div class="bet-header">
                        <h5>Aposta ${betCount}</h5>
                        <button type="button" class="btn-icon-small remove-bet"><i class="fas fa-times"></i></button>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label for="betHouse${betCount}">Casa de Apostas</label>
                            <input type="text" id="betHouse${betCount}" required placeholder="Ex: Sportingbet">
                        </div>
                        <div class="form-group">
                            <label for="betMarket${betCount}">Mercado</label>
                            <input type="text" id="betMarket${betCount}" required placeholder="Ex: Mais/Menos Gols">
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label for="betOdds${betCount}">Odds</label>
                            <input type="number" id="betOdds${betCount}" required step="0.01" min="1" placeholder="2.00">
                        </div>
                        <div class="form-group">
                            <label for="betStake${betCount}">Valor Apostado (R$)</label>
                            <input type="number" id="betStake${betCount}" required step="0.01" min="0" placeholder="100.00">
                        </div>
                    </div>
                `;
                
                // Insere antes do botão
                entryBetsContainer.insertBefore(newBet, addMoreBetBtn);
                
                // Adiciona handler para remover aposta
                const removeBtn = newBet.querySelector('.remove-bet');
                removeBtn.addEventListener('click', function() {
                    newBet.remove();
                });
            });

            // Formulário de nova entrada
            const newEntryForm = document.getElementById('newEntryForm');
            newEntryForm.addEventListener('submit', async function(event) {
                event.preventDefault();

                const bankrollId = new URLSearchParams(window.location.search).get('id');
                const entryEvent = document.getElementById('entryEvent').value;
                const entryCompetition = document.getElementById('entryCompetition').value;
                const entryDate = document.getElementById('entryDate').value;
                const entryTime = document.getElementById('entryTime').value;
                const entryNotes = document.getElementById('entryNotes').value;

                const entryBetsData = [];
                const betElements = entryBetsContainer.querySelectorAll('.entry-bet');
                
                for (let i = 0; i < betElements.length; i++) {
                    const betElement = betElements[i];
                    // Os IDs dos inputs são betHouse1, betMarket1, etc. para o primeiro, 
                    // mas para os adicionados dinamicamente, eles seguem o betCount (betHouse2, betHouse3...)
                    // Portanto, precisamos encontrar os inputs dentro de cada betElement.
                    const house = betElement.querySelector(`input[id^="betHouse"]`).value;
                    const market = betElement.querySelector(`input[id^="betMarket"]`).value;
                    const odds = betElement.querySelector(`input[id^="betOdds"]`).value;
                    const stake = betElement.querySelector(`input[id^="betStake"]`).value;

                    if (!house || !market || !odds || !stake) {
                        alert('Por favor, preencha todos os campos de todas as apostas.');
                        return;
                    }
                    entryBetsData.push({ house, market, odds, stake });
                }

                if (entryBetsData.length === 0) {
                    alert('Adicione pelo menos uma aposta para a entrada.');
                    return;
                }

                const formData = {
                    bankrollId,
                    entryEvent,
                    entryCompetition,
                    entryDate,
                    entryTime,
                    entryNotes,
                    entryBets: entryBetsData
                };

                try {
                    const response = await fetch('/api/surebet/entries', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        body: JSON.stringify(formData),
                    });

                    const result = await response.json();

                    if (!response.ok) {
                        throw new Error(result.msg || `Erro HTTP: ${response.status}`);
                    }

                    alert(result.msg || 'Entrada salva com sucesso!');
                    newEntryForm.reset();
                    newEntryModal.classList.remove('active');
                    fetchSurebetEntries(); // Atualizar a tabela após salvar

                } catch (error) {
                    console.error('Erro ao salvar entrada:', error);
                    alert(`Erro ao salvar entrada: ${error.message}`);
                }
            });

            // Calculadora
            const calculateBtn = document.getElementById('calculateBtn');
            const resetCalcBtn = document.getElementById('resetCalcBtn');
            
            calculateBtn.addEventListener('click', function() {
                const totalStake = parseFloat(document.getElementById('totalStake').value) || 0;
                const odds1 = parseFloat(document.getElementById('odds1').value) || 0;
                const odds2 = parseFloat(document.getElementById('odds2').value) || 0;
                
                if (totalStake <= 0 || odds1 <= 1 || odds2 <= 1) {
                    alert('Por favor, preencha todos os campos corretamente.');
                    return;
                }
                
                // Cálculo de arbitragem simples
                const totalImpliedProbability = (1/odds1) + (1/odds2);
                
                if (totalImpliedProbability >= 1) {
                    // Não é uma surebet
                    document.getElementById('guaranteedProfit').textContent = 'Não é Surebet';
                    document.getElementById('returnPercentage').textContent = 'N/A';
                    return;
                }
                
                const profit = (totalStake / totalImpliedProbability) - totalStake;
                const returnPercentage = (profit / totalStake) * 100;
                
                const stake1 = totalStake * (1/odds1) / totalImpliedProbability;
                const stake2 = totalStake * (1/odds2) / totalImpliedProbability;
                
                document.getElementById('guaranteedProfit').textContent = `R$ ${profit.toFixed(2)}`;
                document.getElementById('returnPercentage').textContent = `${returnPercentage.toFixed(2)}%`;
                document.getElementById('stakeBookmaker1').textContent = `R$ ${stake1.toFixed(2)}`;
                document.getElementById('stakeBookmaker2').textContent = `R$ ${stake2.toFixed(2)}`;
            });
            
            resetCalcBtn.addEventListener('click', function() {
                document.getElementById('totalStake').value = '';
                document.getElementById('odds1').value = '';
                document.getElementById('odds2').value = '';
                document.getElementById('bookmaker1').value = '';
                document.getElementById('bookmaker2').value = '';
                document.getElementById('market1').value = '';
                document.getElementById('market2').value = '';
                
                document.getElementById('guaranteedProfit').textContent = 'R$ 0,00';
                document.getElementById('returnPercentage').textContent = '0%';
                document.getElementById('stakeBookmaker1').textContent = 'R$ 0,00';
                document.getElementById('stakeBookmaker2').textContent = 'R$ 0,00';
            });

            // Pré-carregar dados se vier de um bankroll específico
            // Código simulado para fins de demonstração
            if (bankrollId) {
                // Aqui seria feita uma requisição para obter os dados do bankroll
                // Exemplo simulado:
                // document.getElementById('bankrollName').textContent = 'Surebet #' + bankrollId;
                // document.getElementById('currentBalance').textContent = 'R$ 1.250,00';
                // document.getElementById('roiValue').textContent = '2,5%';
                 // Os dados agora são injetados diretamente pelo EJS, então esta parte pode ser removida ou ajustada
            }

            // Função para deletar uma entrada de surebet
            async function deleteSurebetEntry(entryId) {
                const confirmation = confirm('Tem certeza que deseja excluir esta entrada? Esta ação não pode ser desfeita.');
                
                if (!confirmation) {
                    return; // Usuário cancelou a exclusão
                }
                
                try {
                    const bankrollId = new URLSearchParams(window.location.search).get('id');
                    console.log(`Tentando excluir entrada ${entryId} da surebet ${bankrollId}`);
                    
                    const response = await fetch(`/api/surebet/entries/${bankrollId}/${entryId}`, {
                        method: 'DELETE',
                        headers: {
                            'Content-Type': 'application/json'
                        }
                    });
                    
                    // Verificar se a resposta é um JSON antes de tentar analisá-la
                    const contentType = response.headers.get('content-type');
                    
                    if (!response.ok) {
                        let errorMessage = 'Erro ao excluir entrada';
                        
                        if (contentType && contentType.includes('application/json')) {
                            try {
                                const errorData = await response.json();
                                errorMessage = errorData.msg || errorMessage;
                            } catch (parseError) {
                                console.error('Erro ao analisar resposta JSON:', parseError);
                                errorMessage = `${errorMessage} (${response.status})`;
                            }
                        } else {
                            errorMessage = `${errorMessage}: API retornou ${response.status}. Verifique se a rota de exclusão está implementada no servidor.`;
                        }
                        
                        throw new Error(errorMessage);
                    }
                    
                    // Recarregar a tabela após exclusão bem-sucedida
                    fetchSurebetEntries();
                    
                    // Mostrar mensagem de sucesso
                    alert('Entrada excluída com sucesso!');
                } catch (error) {
                    console.error('Erro ao excluir entrada:', error);
                    alert(`Erro ao excluir entrada: ${error.message}`);
                }
            }
            
            // Carregar entradas inicialmente se a aba "Entries" estiver ativa por padrão
            if (document.querySelector('.tab-btn[data-tab="entries"].active')) {
                fetchSurebetEntries();
            }

            // Lógica para filtros da tabela de entradas
            const dateFilterEntries = document.getElementById('dateFilterEntries');
            const statusFilterEntries = document.getElementById('statusFilterEntries');
            const searchEntriesInput = document.getElementById('searchEntries');

            function applyFilters() {
                const filters = {
                    period: dateFilterEntries.value,
                    status: statusFilterEntries.value,
                    search: searchEntriesInput.value.trim()
                };
                fetchSurebetEntries(filters);
            }

            dateFilterEntries.addEventListener('change', applyFilters);
            statusFilterEntries.addEventListener('change', applyFilters);
            searchEntriesInput.addEventListener('input', () => {
                // debounce para evitar muitas requisições ao digitar
                clearTimeout(searchEntriesInput.timer);
                searchEntriesInput.timer = setTimeout(applyFilters, 500);
            });
            
            // Usar o listener global para fechar os menus
        });
    </script>
    <script src="/js/main.js"></script>
