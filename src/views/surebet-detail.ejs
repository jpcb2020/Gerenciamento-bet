<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Detalhes Surebet - BetManager</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/surebet-detail.css">
    <link rel="stylesheet" href="/css/toast-modal.css">
</head>
<body>
    <div class="container">
        <!-- Sidebar -->
        <aside class="sidebar">
            <div class="sidebar-header">
                <h1>BetManager</h1>
                <button id="menu-toggle" class="mobile-menu-btn">
                    <i class="fas fa-bars"></i>
                </button>
            </div>
            <nav class="sidebar-nav">
                <ul>
                    <li>
                        <a href="/dashboard"><i class="fas fa-tachometer-alt"></i> Dashboard</a>
                    </li>
                    <li>
                        <a href="/casas-de-apostas"><i class="fas fa-home"></i> Casas de Apostas</a>
                    </li>
                    <li>
                        <a href="/transacoes"><i class="fas fa-exchange-alt"></i> Transações</a>
                    </li>
                    <li>
                        <a href="/bankrolls"><i class="fas fa-wallet"></i> Bankrolls</a>
                    </li>
                    <li>
                        <a href="#relatorios"><i class="fas fa-chart-bar"></i> Relatórios</a>
                    </li>
                    <li>
                        <a href="#configuracoes"><i class="fas fa-cog"></i> Configurações</a>
                    </li>
                    <li class="logout-item">
                        <a href="#" id="logout-btn"><i class="fas fa-sign-out-alt"></i> Logout</a>
                    </li>
                </ul>
            </nav>
            <div class="sidebar-footer">
                <p>© 2025 BetManager</p>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="main-content">
            <header class="main-header">
                <div class="header-search">
                    <input type="text" placeholder="Pesquisar...">
                    <i class="fas fa-search"></i>
                </div>
                <div class="header-user">
                    <div class="notifications">
                        <i class="fas fa-bell"></i>
                        <span class="badge">3</span>
                    </div>
                    <div class="user-profile">
                        <img src="https://via.placeholder.com/40" alt="Profile">
                        <span>Usuário</span>
                    </div>
                </div>
            </header>

            <div class="content-wrapper">
                <div class="page-title">
                    <h2><a href="/bankrolls" class="back-link"><i class="fas fa-arrow-left"></i></a> <span id="bankrollName"><%= bankroll.nome %></span></h2>
                    <div class="action-buttons">
                        <button id="addSurebetEntryBtn" class="btn-primary"><i class="fas fa-plus"></i> Nova Entrada</button>
                        <button id="configSurebetBtn" class="btn-outline"><i class="fas fa-cog"></i> Configurar</button>
                    </div>
                </div>

                <!-- Área do cabeçalho da Surebet -->
                <div class="surebet-header">
                    <div class="surebet-info">
                        <div class="tag tag-surebet">Surebet</div>
                        <div class="surebet-balance">
                            <span class="balance-label">Saldo Atual:</span>
                            <h3 id="currentBalance"><%= parseFloat(bankroll.saldo_atual).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) %></h3>
                        </div>
                        <div class="surebet-stats">
                            <div class="stat-item">
                                <span class="stat-label"><i class="fas fa-chart-line"></i> ROI:</span>
                                <span class="stat-value" id="roiValue"><%= bankroll.roi || '0' %>%</span>
                            </div>
                            <div class="stat-item">
                                <span class="stat-label"><i class="fas fa-calendar-alt"></i> Período:</span>
                                <span class="stat-value" id="periodValue">N/A</span>
                            </div>
                        </div>
                    </div>
                    <div class="surebet-chart">
                        <div class="chart-placeholder">
                            <div class="chart-label">Evolução do Bankroll</div>
                            <div class="chart-area" id="balanceChart">
                                <!-- Canvas para o gráfico será inserido via JavaScript -->
                                <div class="no-data-message">
                                    <i class="fas fa-chart-area"></i>
                                    <p>Gráfico de evolução será exibido aqui</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Área das Abas -->
                <div class="surebet-tabs">
                    <div class="tab-header">
                        <button class="tab-btn active" data-tab="entries">
                            <i class="fas fa-list"></i> Entradas
                        </button>
                        <button class="tab-btn" data-tab="opportunities">
                            <i class="fas fa-bolt"></i> Oportunidades
                        </button>
                        <button class="tab-btn" data-tab="calculator">
                            <i class="fas fa-calculator"></i> Calculadora
                        </button>
                        <button class="tab-btn" data-tab="statistics">
                            <i class="fas fa-chart-pie"></i> Estatísticas
                        </button>
                    </div>

                    <div class="tab-content">
                        <!-- Aba de Entradas -->
                        <div class="tab-pane active" id="entriesTab">
                            <div class="entries-header">
                                <div class="entries-filters">
                                    <div class="filter-group">
                                        <label for="dateFilterEntries">Período:</label>
                                        <select id="dateFilterEntries" class="filter-control">
                                            <option value="7">Últimos 7 dias</option>
                                            <option value="30" selected>Últimos 30 dias</option>
                                            <option value="90">Últimos 90 dias</option>
                                            <option value="all">Todo período</option>
                                        </select>
                                    </div>
                                    <div class="filter-group">
                                        <label for="statusFilterEntries">Status:</label>
                                        <select id="statusFilterEntries" class="filter-control">
                                            <option value="all" selected>Todos</option>
                                            <option value="active">Ativos</option>
                                            <option value="completed">Completados</option>
                                            <option value="cancelled">Cancelados</option>
                                        </select>
                                    </div>
                                    <div class="search-entries">
                                        <input type="text" id="searchEntries" placeholder="Buscar entradas...">
                                    </div>
                                </div>
                            </div>

                            <div class="entries-table-container">
                                <table class="entries-table">
                                    <thead>
                                        <tr>
                                            <th><i class="fas fa-calendar-alt"></i> Data</th>
                                            <th><i class="fas fa-futbol"></i> Evento</th>
                                            <th><i class="fas fa-home"></i> Casas de Apostas</th>
                                            <th><i class="fas fa-dollar-sign"></i> Valor Apostado</th>
                                            <th><i class="fas fa-chart-line"></i> Retorno</th>
                                            <th><i class="fas fa-trophy"></i> Lucro</th>
                                            <th><i class="fas fa-info-circle"></i> Status</th>
                                            <th><i class="fas fa-cogs"></i> Ações</th>
                                        </tr>
                                    </thead>
                                    <tbody id="entriesTableBody">
                                        <!-- Conteúdo da tabela será preenchido via JavaScript -->
                                        <tr>
                                            <td colspan="8" class="empty-state">
                                                <div class="empty-state-content">
                                                    <i class="fas fa-list"></i>
                                                    <h3>Nenhuma entrada encontrada</h3>
                                                    <p>Adicione uma nova entrada usando o botão "Nova Entrada".</p>
                                                </div>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Aba de Oportunidades -->
                        <div class="tab-pane" id="opportunitiesTab">
                            <div class="opportunities-container">
                                <div class="opportunities-header">
                                    <h3>Oportunidades de Surebet</h3>
                                    <p>Configure as fontes de dados em Configurações</p>
                                </div>
                                <div class="opportunities-grid" id="opportunitiesGrid">
                                    <!-- Cards de oportunidades serão preenchidos via JavaScript -->
                                    <div class="opportunity-card">
                                        <div class="opportunity-header">
                                            <span class="opportunity-date">26/07/2023 - 21:00</span>
                                            <span class="opportunity-profit">Lucro: 2,5%</span>
                                        </div>
                                        <div class="opportunity-event">
                                            <h4>Flamengo vs Palmeiras</h4>
                                            <p>Campeonato Brasileiro</p>
                                        </div>
                                        <div class="opportunity-bets">
                                            <div class="opportunity-bet">
                                                <span class="bet-house">Bet365</span>
                                                <span class="bet-market">Vitória Flamengo</span>
                                                <span class="bet-odds">2.10</span>
                                            </div>
                                            <div class="opportunity-bet">
                                                <span class="bet-house">Betano</span>
                                                <span class="bet-market">Empate ou Palmeiras</span>
                                                <span class="bet-odds">1.85</span>
                                            </div>
                                        </div>
                                        <div class="opportunity-actions">
                                            <button class="btn-outline btn-sm">Calcular</button>
                                            <button class="btn-primary btn-sm">Registrar</button>
                                        </div>
                                    </div>
                                    
                                    <div class="empty-opportunities">
                                        <i class="fas fa-bolt"></i>
                                        <h3>Nenhuma oportunidade encontrada</h3>
                                        <p>Configure suas fontes de dados ou verifique mais tarde</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Aba da Calculadora -->
                        <div class="tab-pane" id="calculatorTab">
                            <div class="calculator-container">
                                <div class="calculator-header">
                                    <h3>Calculadora de Surebet</h3>
                                    <p>Calcule valores para apostas de arbitragem</p>
                                </div>
                                <div class="calculator-form">
                                    <div class="calculator-section">
                                        <h4>Configuração da Aposta</h4>
                                        <div class="form-row">
                                            <div class="form-group">
                                                <label for="totalStake">Valor Total (R$)</label>
                                                <input type="number" id="totalStake" placeholder="100,00" step="0.01" min="0">
                                            </div>
                                            <div class="form-group">
                                                <label for="bookmakerCount">Número de Casas</label>
                                                <select id="bookmakerCount">
                                                    <option value="2">2 Casas</option>
                                                    <option value="3">3 Casas</option>
                                                    <option value="4">4 Casas</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="calculator-odds" id="oddsContainer">
                                        <div class="odds-row">
                                            <div class="form-group">
                                                <label for="bookmaker1">Casa de Apostas 1</label>
                                                <input type="text" id="bookmaker1" placeholder="Bet365" autocomplete="off">
                                            </div>
                                            <div class="form-group">
                                                <label for="market1">Mercado</label>
                                                <input type="text" id="market1" placeholder="Vitória Casa">
                                            </div>
                                            <div class="form-group">
                                                <label for="odds1">Odds</label>
                                                <input type="number" id="odds1" placeholder="2.00" step="0.01" min="1">
                                            </div>
                                        </div>
                                        <div class="odds-row">
                                            <div class="form-group">
                                                <label for="bookmaker2">Casa de Apostas 2</label>
                                                <input type="text" id="bookmaker2" placeholder="Betano" autocomplete="off">
                                            </div>
                                            <div class="form-group">
                                                <label for="market2">Mercado</label>
                                                <input type="text" id="market2" placeholder="Empate ou Fora">
                                            </div>
                                            <div class="form-group">
                                                <label for="odds2">Odds</label>
                                                <input type="number" id="odds2" placeholder="1.90" step="0.01" min="1">
                                            </div>
                                        </div>
                                    </div>

                                    <div class="calculator-buttons">
                                        <button id="calculateBtn" class="btn-primary">Calcular</button>
                                        <button id="resetCalcBtn" class="btn-outline">Limpar</button>
                                    </div>

                                    <div class="calculator-results" id="calculatorResults">
                                        <h4>Resultados</h4>
                                        <div class="results-grid">
                                            <div class="result-item">
                                                <div class="result-label">Lucro Garantido</div>
                                                <div class="result-value" id="guaranteedProfit">R$ 0,00</div>
                                            </div>
                                            <div class="result-item">
                                                <div class="result-label">Retorno (%)</div>
                                                <div class="result-value" id="returnPercentage">0%</div>
                                            </div>
                                            <div class="result-item">
                                                <div class="result-label">Valor Casa 1</div>
                                                <div class="result-value" id="stakeBookmaker1">R$ 0,00</div>
                                            </div>
                                            <div class="result-item">
                                                <div class="result-label">Valor Casa 2</div>
                                                <div class="result-value" id="stakeBookmaker2">R$ 0,00</div>
                                            </div>
                                        </div>
                                        <div class="calculator-save">
                                            <button id="saveCalcBtn" class="btn-primary btn-block">Salvar como Entrada</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Aba de Estatísticas -->
                        <div class="tab-pane" id="statisticsTab">
                            <div class="statistics-container">
                                <div class="statistics-header">
                                    <h3>Estatísticas de Desempenho</h3>
                                    <div class="statistics-period">
                                        <label for="statsDateFilter">Período:</label>
                                        <select id="statsDateFilter" class="filter-control">
                                            <option value="30" selected>Últimos 30 dias</option>
                                            <option value="90">Últimos 90 dias</option>
                                            <option value="180">Últimos 6 meses</option>
                                            <option value="365">Último ano</option>
                                            <option value="all">Todo o período</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="statistics-grid">
                                    <div class="stat-card">
                                        <div class="stat-card-header">
                                            <h4>Desempenho Geral</h4>
                                        </div>
                                        <div class="stat-card-body">
                                            <div class="stat-metrics">
                                                <div class="stat-metric">
                                                    <div class="metric-label">Total de Apostas</div>
                                                    <div class="metric-value" id="totalBetsCount">0</div>
                                                </div>
                                                <div class="stat-metric">
                                                    <div class="metric-label">Lucro Total</div>
                                                    <div class="metric-value" id="totalProfit">R$ 0,00</div>
                                                </div>
                                                <div class="stat-metric">
                                                    <div class="metric-label">ROI Médio</div>
                                                    <div class="metric-value" id="averageROI">0%</div>
                                                </div>
                                                <div class="stat-metric">
                                                    <div class="metric-label">Valor Médio</div>
                                                    <div class="metric-value" id="averageStake">R$ 0,00</div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="stat-card chart-card">
                                        <div class="stat-card-header">
                                            <h4>Lucro por Período</h4>
                                        </div>
                                        <div class="stat-card-body">
                                            <div class="chart-container" id="profitByPeriodChart">
                                                <!-- Canvas para o gráfico será inserido via JavaScript -->
                                                <div class="no-data-message">
                                                    <i class="fas fa-chart-line"></i>
                                                    <p>Gráfico de lucro por período</p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="stat-card">
                                        <div class="stat-card-header">
                                            <h4>Casas de Apostas Mais Utilizadas</h4>
                                        </div>
                                        <div class="stat-card-body">
                                            <div class="chart-container" id="bookmakerDistributionChart">
                                                <!-- Canvas para o gráfico será inserido via JavaScript -->
                                                <div class="no-data-message">
                                                    <i class="fas fa-chart-pie"></i>
                                                    <p>Distribuição por casas de apostas</p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="stat-card">
                                        <div class="stat-card-header">
                                            <h4>Distribuição por Tipo de Mercado</h4>
                                        </div>
                                        <div class="stat-card-body">
                                            <div class="chart-container" id="marketTypeChart">
                                                <!-- Canvas para o gráfico será inserido via JavaScript -->
                                                <div class="no-data-message">
                                                    <i class="fas fa-chart-pie"></i>
                                                    <p>Distribuição por tipo de mercado</p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <!-- Modal para Adicionar Nova Entrada -->
    <div id="newEntryModal" class="modal">
        <div class="modal-content modern-modal">
            <div class="modal-header modern-header">
                <div class="header-content">
                    <div class="header-icon">
                        <i class="fas fa-chart-line"></i>
                    </div>
                    <div class="header-text">
                        <h3>Nova Entrada de Surebet</h3>
                        <p>Configure uma nova oportunidade de arbitragem</p>
                    </div>
                </div>
                <button class="close-modal modern-close" type="button">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            
            <div class="modal-body-scrollable modern-body">
                <form id="newEntryForm">
                    <!-- Seção de Informações do Evento -->
                    <div class="form-section">
                        <div class="section-header">
                            <i class="fas fa-calendar-alt"></i>
                            <h4>Informações do Evento</h4>
                        </div>
                        
                        <div class="form-group modern-input">
                            <label for="entryEvent">
                                <i class="fas fa-futbol"></i>
                                Evento
                            </label>
                            <input type="text" id="entryEvent" required placeholder="Ex: Flamengo vs Palmeiras">
                        </div>
                        
                        <div class="form-group modern-input">
                            <label for="entryCompetition">
                                <i class="fas fa-trophy"></i>
                                Competição
                            </label>
                            <input type="text" id="entryCompetition" placeholder="Ex: Campeonato Brasileiro">
                        </div>
                        
                        <div class="form-row">
                            <div class="form-group modern-input">
                                <label for="entryDate">
                                    <i class="fas fa-calendar"></i>
                                    Data
                                </label>
                                <input type="date" id="entryDate" required>
                            </div>
                            <div class="form-group modern-input">
                                <label for="entryTime">
                                    <i class="fas fa-clock"></i>
                                    Hora
                                </label>
                                <input type="time" id="entryTime" required>
                            </div>
                        </div>
                    </div>

                    <!-- Seção de Apostas -->
                    <div class="form-section">
                        <div class="section-header">
                            <i class="fas fa-dice"></i>
                            <h4>Configuração das Apostas</h4>
                        </div>
                        
                        <div class="entry-bets modern-bets" id="entryBetsContainer">
                            <div class="entry-bet modern-bet-card">
                                <div class="bet-header">
                                    <div class="bet-number">
                                        <span class="bet-badge">1</span>
                                        <h5>Primeira Aposta</h5>
                                    </div>
                                    <button type="button" class="btn-icon-small remove-bet"><i class="fas fa-times"></i></button>
                                </div>
                                
                                <div class="bet-content">
                                    <div class="form-row">
                                        <div class="form-group modern-input">
                                            <label for="betHouse1">
                                                <i class="fas fa-home"></i>
                                                Casa de Apostas
                                            </label>
                                            <input type="text" id="betHouse1" required placeholder="Ex: Bet365" autocomplete="off">
                                        </div>
                                        <div class="form-group modern-input">
                                            <label for="betMarket1">
                                                <i class="fas fa-target"></i>
                                                Mercado
                                            </label>
                                            <input type="text" id="betMarket1" required placeholder="Ex: Vitória Mandante">
                                        </div>
                                    </div>
                                    <div class="form-row">
                                        <div class="form-group modern-input">
                                            <label for="betOdds1">
                                                <i class="fas fa-percentage"></i>
                                                Odds
                                            </label>
                                            <input type="number" id="betOdds1" required step="0.01" min="1" placeholder="2.00">
                                        </div>
                                        <div class="form-group modern-input">
                                            <label for="betStake1">
                                                <i class="fas fa-dollar-sign"></i>
                                                Valor Apostado (R$)
                                            </label>
                                            <input type="number" id="betStake1" required step="0.01" min="0" placeholder="100.00">
                                        </div>
                                    </div>
                                    
                                    <!-- Exchange Options -->
                                    <div class="form-row">
                                        <div class="form-group modern-checkbox">
                                            <label class="checkbox-container">
                                                <input type="checkbox" id="isExchange1" onchange="toggleExchangeFields(1)">
                                                <span class="checkmark"></span>
                                                <i class="fas fa-exchange-alt"></i>
                                                É Exchange?
                                            </label>
                                        </div>
                                    </div>
                                    
                                    <div class="exchange-fields" id="exchangeFields1" style="display: none;">
                                        <div class="form-row">
                                            <div class="form-group modern-input">
                                                <label for="betType1">
                                                    <i class="fas fa-arrows-alt-h"></i>
                                                    Tipo de Aposta
                                                </label>
                                                <select id="betType1" onchange="toggleLiabilityField(1)">
                                                    <option value="back">Back (Apostar A Favor)</option>
                                                    <option value="lay">Lay (Apostar Contra)</option>
                                                </select>
                                            </div>
                                            <div class="form-group modern-input">
                                                <label for="commission1">
                                                    <i class="fas fa-percent"></i>
                                                    Comissão (%)
                                                </label>
                                                <input type="number" id="commission1" step="0.1" min="0" max="100" placeholder="5.0">
                                            </div>
                                        </div>
                                        <div class="form-row liability-row" id="liabilityRow1" style="display: none;">
                                            <div class="form-group modern-input">
                                                <label for="liability1">
                                                    <i class="fas fa-exclamation-triangle"></i>
                                                    Responsabilidade (R$)
                                                </label>
                                                <input type="number" id="liability1" step="0.01" min="0" placeholder="Calculado automaticamente" readonly>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="entry-bet modern-bet-card">
                                <div class="bet-header">
                                    <div class="bet-number">
                                        <span class="bet-badge">2</span>
                                        <h5>Segunda Aposta</h5>
                                    </div>
                                    <button type="button" class="btn-icon-small remove-bet"><i class="fas fa-times"></i></button>
                                </div>
                                
                                <div class="bet-content">
                                    <div class="form-row">
                                        <div class="form-group modern-input">
                                            <label for="betHouse2">
                                                <i class="fas fa-home"></i>
                                                Casa de Apostas
                                            </label>
                                            <input type="text" id="betHouse2" required placeholder="Ex: Betano" autocomplete="off">
                                        </div>
                                        <div class="form-group modern-input">
                                            <label for="betMarket2">
                                                <i class="fas fa-target"></i>
                                                Mercado
                                            </label>
                                            <input type="text" id="betMarket2" required placeholder="Ex: Empate ou Fora">
                                        </div>
                                    </div>
                                    <div class="form-row">
                                        <div class="form-group modern-input">
                                            <label for="betOdds2">
                                                <i class="fas fa-percentage"></i>
                                                Odds
                                            </label>
                                            <input type="number" id="betOdds2" required step="0.01" min="1" placeholder="1.90">
                                        </div>
                                        <div class="form-group modern-input">
                                            <label for="betStake2">
                                                <i class="fas fa-dollar-sign"></i>
                                                Valor Apostado (R$)
                                            </label>
                                            <input type="number" id="betStake2" required step="0.01" min="0" placeholder="100.00">
                                        </div>
                                    </div>
                                    
                                    <!-- Exchange Options -->
                                    <div class="form-row">
                                        <div class="form-group modern-checkbox">
                                            <label class="checkbox-container">
                                                <input type="checkbox" id="isExchange2" onchange="toggleExchangeFields(2)">
                                                <span class="checkmark"></span>
                                                <i class="fas fa-exchange-alt"></i>
                                                É Exchange?
                                            </label>
                                        </div>
                                    </div>
                                    
                                    <div class="exchange-fields" id="exchangeFields2" style="display: none;">
                                        <div class="form-row">
                                            <div class="form-group modern-input">
                                                <label for="betType2">
                                                    <i class="fas fa-arrows-alt-h"></i>
                                                    Tipo de Aposta
                                                </label>
                                                <select id="betType2" onchange="toggleLiabilityField(2)">
                                                    <option value="back">Back (Apostar A Favor)</option>
                                                    <option value="lay">Lay (Apostar Contra)</option>
                                                </select>
                                            </div>
                                            <div class="form-group modern-input">
                                                <label for="commission2">
                                                    <i class="fas fa-percent"></i>
                                                    Comissão (%)
                                                </label>
                                                <input type="number" id="commission2" step="0.1" min="0" max="100" placeholder="5.0">
                                            </div>
                                        </div>
                                        <div class="form-row liability-row" id="liabilityRow2" style="display: none;">
                                            <div class="form-group modern-input">
                                                <label for="liability2">
                                                    <i class="fas fa-exclamation-triangle"></i>
                                                    Responsabilidade (R$)
                                                </label>
                                                <input type="number" id="liability2" step="0.01" min="0" placeholder="Calculado automaticamente" readonly>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <button type="button" id="addMoreBetBtn" class="btn-add-bet">
                                <i class="fas fa-plus"></i>
                                <span>Adicionar Outra Aposta</span>
                            </button>
                        </div>
                    </div>

                    <!-- Seção de Observações -->
                    <div class="form-section">
                        <div class="section-header">
                            <i class="fas fa-sticky-note"></i>
                            <h4>Observações</h4>
                        </div>
                        
                        <div class="form-group modern-input">
                            <label for="entryNotes">
                                <i class="fas fa-comment"></i>
                                Notas Adicionais
                            </label>
                            <textarea id="entryNotes" rows="3" placeholder="Adicione observações sobre esta surebet, estratégias ou informações importantes..."></textarea>
                        </div>
                    </div>

                    <div class="form-actions modern-actions">
                        <button type="button" id="cancelEntryBtn" class="btn-cancel">
                            <i class="fas fa-times"></i>
                            Cancelar
                        </button>
                        <button type="submit" class="btn-save">
                            <i class="fas fa-save"></i>
                            Salvar Entrada
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="/js/toast-modal.js"></script>
    <script src="/js/surebet-detail.js"></script>
    <script src="/js/main.js"></script>
    <script src="/js/logout.js"></script>
</body>
</html>