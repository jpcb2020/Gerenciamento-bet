<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Transações - BetManager</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="css/style.css">
</head>
<body>
    <div class="container">
        <!-- Sidebar -->
        <aside class="sidebar">
            <div class="sidebar-header">
                <h1>BetManager</h1>
                <button id="menu-toggle" class="mobile-menu-btn">
                    <i class="fas fa-bars"></i>
                </button>
            </div>
            <nav class="sidebar-nav">
                <ul>
                    <li>
                        <a href="/"><i class="fas fa-tachometer-alt"></i> Dashboard</a>
                    </li>
                    <li>
                        <a href="/casas-de-apostas"><i class="fas fa-home"></i> Casas de Apostas</a>
                    </li>
                    <li class="active">
                        <a href="/transacoes"><i class="fas fa-exchange-alt"></i> Transações</a>
                    </li>
                    <li>
                        <a href="/bankrolls"><i class="fas fa-wallet"></i> Bankrolls</a>
                    </li>
                    <li>
                        <a href="#relatorios"><i class="fas fa-chart-bar"></i> Relatórios</a>
                    </li>
                    <li>
                        <a href="#configuracoes"><i class="fas fa-cog"></i> Configurações</a>
                    </li>
                </ul>
            </nav>
            <div class="sidebar-footer">
                <p>© 2025 BetManager</p>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="main-content">
            <header class="main-header">
                <div class="header-search">
                    <input type="text" placeholder="Pesquisar...">
                    <i class="fas fa-search"></i>
                </div>
                <div class="header-user">
                    <div class="notifications">
                        <i class="fas fa-bell"></i>
                        <span class="badge">3</span>
                    </div>
                    <div class="user-profile">
                        <img src="https://via.placeholder.com/40" alt="Profile">
                        <span>Usuário</span>
                    </div>
                </div>
            </header>

            <div class="content-wrapper">
                <!-- Page Title -->
                <div class="page-title">
                    <h2>Transações</h2>
                    <div class="date-filter">
                        <label for="dateRange">Filtrar por Data:</label>
                        <input type="date" id="startDate">
                        <span>até</span>
                        <input type="date" id="endDate">
                        <button class="btn-primary" id="filterDateRange">Filtrar</button>
                    </div>
                </div>

                <!-- Dashboard Panels -->
                <div class="dashboard-panels">
                    <div class="panel panel-primary">
                        <div class="panel-icon">
                            <i class="fas fa-money-bill-wave"></i>
                        </div>
                        <div class="panel-content">
                            <h4>Movimentação do Dia</h4>
                            <div class="panel-stats">
                                <div class="stat-item">
                                    <span class="stat-label">Entradas:</span>
                                    <span class="stat-value income" id="dailyIncome">R$ 0,00</span>
                                </div>
                                <div class="stat-item">
                                    <span class="stat-label">Saídas:</span>
                                    <span class="stat-value expense" id="dailyExpense">R$ 0,00</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="panel panel-success">
                        <div class="panel-icon">
                            <i class="fas fa-wallet"></i>
                        </div>
                        <div class="panel-content">
                            <h4>Saldo Consolidado</h4>
                            <p class="panel-value" id="totalBalance">R$ 0,00</p>
                            <span class="panel-change" id="balanceChange">0% desde ontem</span>
                        </div>
                    </div>
                    
                    <div class="panel panel-info">
                        <div class="panel-icon">
                            <i class="fas fa-exchange-alt"></i>
                        </div>
                        <div class="panel-content">
                            <h4>Total de Transações</h4>
                            <p class="panel-value" id="transactionCount">0</p>
                            <span class="panel-label">no período selecionado</span>
                        </div>
                    </div>
                    
                    <div class="panel panel-warning">
                        <div class="panel-icon">
                            <i class="fas fa-trophy"></i>
                        </div>
                        <div class="panel-content">
                            <h4>Casa Mais Ativa</h4>
                            <p class="panel-value" id="topHouseName">-</p>
                            <div class="panel-stats">
                                <div class="stat-item">
                                    <span class="stat-label">Transações:</span>
                                    <span class="stat-value" id="topHouseCount">0</span>
                                </div>
                                <div class="stat-item">
                                    <span class="stat-label">Saldo:</span>
                                    <span class="stat-value" id="topHouseBalance">R$ 0,00</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Transactions Section -->
                <div class="section">
                    <div class="section-header">
                        <h3>Todas as Transações</h3>
                        <div>
                            <button id="deletarTodasTransacoesBtn" class="btn btn-danger btn-with-icon">
                                <i class="fas fa-trash-alt"></i>
                                <span>Deletar Todas</span>
                            </button>
                            <select id="filterType" class="filter-control">
                                <option value="">Todos os Tipos</option>
                                <option value="deposito">Depósito</option>
                                <option value="saque">Saque</option>
                                <option value="aposta">Aposta</option>
                                <option value="ganho">Ganho</option>
                                <option value="correcao">Correção</option>
                            </select>
                            <select id="filterHouse" class="filter-control">
                                <option value="">Todas as Casas</option>
                                <!-- Options will be populated by JS -->
                            </select>
                            <input type="text" id="searchDescription" class="filter-control" placeholder="Buscar por descrição...">
                        </div>
                    </div>
                    <div class="transactions-table-full">
                        <table>
                            <thead>
                                <tr>
                                    <th data-sort="data">Data <i class="fas fa-sort"></i></th>
                                    <th data-sort="casa_nome">Casa <i class="fas fa-sort"></i></th>
                                    <th data-sort="tipo">Tipo <i class="fas fa-sort"></i></th>
                                    <th data-sort="valor">Valor <i class="fas fa-sort"></i></th>
                                    <th data-sort="saldo_anterior">Saldo Anterior <i class="fas fa-sort"></i></th>
                                    <th data-sort="saldo_posterior">Saldo Posterior <i class="fas fa-sort"></i></th>
                                    <th>Descrição/Obs</th>
                                    <th>Ações</th>
                                </tr>
                            </thead>
                            <tbody id="transactionsTableBody">
                                <!-- Transactions will be loaded here by JavaScript -->
                                <tr>
                                    <td colspan="8" class="empty-transactions">
                                        <div class="empty-state">
                                            <i class="fas fa-exchange-alt"></i>
                                            <h3>Nenhuma transação encontrada</h3>
                                            <p>As transações aparecerão aqui após o carregamento ou aplicação dos filtros.</p>
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <div class="pagination-controls">
                           <button id="prevPage" disabled>Anterior</button>
                           <span id="pageInfo">Página 1 de 1</span>
                           <button id="nextPage" disabled>Próxima</button>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <script src="js/transacoes.js"></script> 
    <script src="js/main.js"></script> <!-- Common JS like sidebar toggle -->
</body>
</html> 